DISCORD_BOT_TOKEN=your-bot-token-here
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
CHIME_IN_THRESHOLD=6
REACT_TO_CHAT=true
REACT_THRESHOLD=8
REACT_ONLY_MAX_WORDS=2
HISTORY_LENGTH=12
REPEAT_WORDS=5
RETRY_TEMPERATURE=1.0
PEOPLE_FILE=people.json
MAX_FACTS_PER_PERSON=20
CHAT_LOG_DIR=chatlogs
DIARY_FILE=diary.json
MAX_LEARNED_PER_PERSON=10
RECAP_DAYS=3
HISTORY_RELOAD_HOURS=12
EARNED_FILE=earned_examples.jsonl
MELD_ANCHOR=0.3
MELD_FULL_AT=200
MELD_RUNS=11
VIBE_MIN_MESSAGES=10
OWNER_USER_IDS=
DELETE_SCAN=200
MUTE_MINUTES=30
MAX_REPLY_TOKENS=200
OLLAMA_THINK=false
FEW_SHOT_EXAMPLES=8
VISION=true
VISION_MODEL=
TASK_MODEL=
VISION_MAX_IMAGES=3
EXAMPLES_FILE=finetuning/gomihyu_seed.jsonl
# Melee results from AI-Melee (README, "Melee results"): nothing needed here, say "gomi post melee
# here" in the channel. MELEE_OUTBOX overrides the folder, MELEE_CHANNEL_ID gives a starting channel.
MELEE_OUTBOX=
MELEE_CHANNEL_ID=
MELEE_MAX_AGE_MINUTES=30
MELEE_PLAYER=
# Weekly fine-tune (finetuning/weekly.py): your Kaggle username, and how many new examples from the
# server a run wants (fewer: that week is skipped).
WEEKLY_KAGGLE_USER=
WEEKLY_MIN_NEW=50
