# Secrets — holds DISCORD_BOT_TOKEN
.env

# Python
venv/
.venv/
__pycache__/
*.pyc

# Training data built from your Discord export by archive/discord-pipeline/*.py: your messages, local only
archive/discord-pipeline/data/
train.jsonl

# Person memory — facts about real server members; stays on the machine running the bot
people.json
people.json.tmp

# Her chat log and diary: the server's messages and what she wrote about them; local only
chatlogs/
diary.json
diary.json.tmp
# Her replies that landed (meld.py), with the chat around them
earned_examples.jsonl
# Weekly fine-tune runs (finetuning/weekly.py): the uploaded data, downloaded models, check reports
finetuning/runs/

# Where her Melee posts go ("gomi post melee here"); per server
melee_channel.json
melee_channel.json.tmp

# Model weights (e.g. the archived LFM2.5 Modelfile's GGUF)
*.gguf

# A Discord data export: personal messages, including DMs. Never commit it.
Messages/
*.zip
